# Required in production: a long random string (openssl rand -base64 32)
AUTH_SECRET=

# Optional: if set, messages are checked with OpenAI's free Moderation API.
# If empty, the built-in rule-based moderation is used.
OPENAI_API_KEY=

# Optional: where the SQLite file lives (default ./data/app.db)
DATABASE_FILE=

# Optional: public site URL used in share links / metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
